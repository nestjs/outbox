generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

/// The application's table: tests/mysql writes it in the application's transactions MySqlOutboxStore joins.
model Order {
  id     String @id @db.VarChar(191)
  status String @db.VarChar(32)

  @@map("orders")
}
